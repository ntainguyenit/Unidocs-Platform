{
  "name": "unidocs",
  "version": "1.0.0",
  "description": "UniDocs - Open-source Academic Document Management Platform",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/output.css --watch",
    "build:campus-3d": "node scripts/build-campus-glb.mjs"
  },
  "keywords": [
    "education",
    "academic",
    "document-management",
    "spring-boot",
    "tailwind"
  ],
  "author": "Tai Nguyen <ntainguyen.it@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "autoprefixer": "^10.5.0",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "three": "^0.187.0"
  }
}
